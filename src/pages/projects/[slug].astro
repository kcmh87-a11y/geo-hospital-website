---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() { return projects.map(project=>({params:{slug:project.slug},props:{project}})); }
const { project } = Astro.props;
---
<Layout title={`${project.category} 콘텐츠 전략 — 가상 프로젝트 | 온율 ONYUL`} description={`${project.summary} 실제 고객사 사례가 아닌 온율의 샘플 포트폴리오입니다.`}>
  <section class="section"><div class="container"><nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><Icon name="chevron" size={12} /><a href="/#portfolio">프로젝트</a><Icon name="chevron" size={12} /><span aria-current="page">{project.category} 샘플</span></nav>
    <div class="project-detail-hero"><div><span class="eyebrow">SAMPLE PROJECT {project.number} / {project.english}</span><span class="outline-tag">가상 프로젝트 · 실제 고객사 사례 아님</span><h1>{project.title}</h1><p>{project.summary}</p><div class="tags">{project.tags.map(tag=><span>{tag}</span>)}</div></div><img src={project.image} alt={project.imageAlt} width="640" height="480" /></div>
    <div class="project-detail-grid"><aside class="project-sidebar"><dl><div><dt>PROJECT TYPE</dt><dd>연습용 콘텐츠 전략 기획</dd></div><div><dt>SPECIALTY</dt><dd>{project.category}</dd></div><div><dt>SCOPE</dt><dd>정보 구조 · 콘텐츠 기획 · 원고</dd></div><div><dt>NOTE</dt><dd>이미지는 AI로 제작한 콘셉트 이미지입니다.</dd></div></dl></aside><div class="prose"><h2>기획의 출발점</h2><p>{project.question}</p><h2>콘텐츠 설계 방향</h2><p>{project.approach}</p><h2>샘플 산출물</h2><ul class="deliverables">{project.deliverables.map(item=><li><Icon name="check" size={18} />{item}</li>)}</ul><h2>원고 구성 예시</h2><div class="sample-copy"><h3>{project.example}</h3><p>{project.exampleBody}</p></div><div class="practice-banner">이 기획은 실제 의료기관에 납품되거나 성과를 측정한 사례가 아닙니다. 실제 사용 시 진료 내용에 맞춰 의료진의 검토를 받고, 관련 법규와 의료광고 심의 대상 여부를 확인해야 합니다.</div><a class="button button-primary" href="/contact/">우리 병원 콘텐츠 상담하기 <Icon name="diagonal" size={18} /></a></div></div>
    <div class="article-end"><a class="text-link" href="/#portfolio">프로젝트 목록으로 <Icon name="arrow" size={18} /></a></div>
  </div></section><ContactCTA />
</Layout>
