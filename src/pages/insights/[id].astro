---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('insights')).map(post=>({params:{id:post.id},props:{post}})); }
const { post } = Astro.props;
const { Content } = await render(post);
const schema = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString().slice(0,10), inLanguage: 'ko-KR', author: { '@type': 'Organization', name: '온율 편집실' }, ...(Astro.site ? { mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href } : {}) };
---
<Layout title={`${post.data.title} | 온율 인사이트`} description={post.data.description} article schema={schema}>
  <article class="article-wrap"><nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><Icon name="chevron" size={12} /><a href="/insights/">인사이트</a><Icon name="chevron" size={12} /><span aria-current="page">칼럼</span></nav>
    <header class="article-header"><span class="eyebrow">ONYUL INSIGHTS / {post.data.category}</span><h1>{post.data.title}</h1><div class="article-meta"><span>온율 편집실 · 샘플 칼럼</span><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10).replaceAll('-','.')}</time><span>{post.data.readTime}분 읽기</span></div><p class="article-intro">{post.data.description}</p></header>
    <div class="prose"><Content /></div>
    <aside class="practice-banner">이 사이트와 칼럼은 개인 브랜딩 연습용입니다. 의료정보는 일반적인 설명이며 진단·치료를 대신하지 않습니다. 실제 의료광고에 활용하기 전 법규와 심의 대상 여부를 검토해 주세요.</aside>
    <div class="article-end"><a class="text-link" href="/insights/"><Icon name="arrow" class="back-arrow" size={18} /> 인사이트 목록</a><button class="button button-outline" id="share-article" type="button"><Icon name="copy" size={17} /> 글 링크 복사</button></div><p class="share-status" role="status"></p>
  </article><ContactCTA />
</Layout>
<script>
  document.querySelector('#share-article')?.addEventListener('click', async () => {
    const status = document.querySelector('.share-status');
    try { await navigator.clipboard.writeText(window.location.href); if (status) status.textContent = '글 링크를 복사했습니다.'; }
    catch { if (status) status.textContent = '주소창의 링크를 직접 복사해 주세요.'; }
  });
</script>
