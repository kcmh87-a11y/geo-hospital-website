---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ProfilePortrait from '../../components/ProfilePortrait.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { site, authorName, personSchema } from '../../config/site';
import { services } from '../../data/services';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('insights')).map(post=>({params:{id:post.id},props:{post}})); }
const { post } = Astro.props;
const { Content } = await render(post);
const relatedService = services.find(service => service.id === post.data.serviceId)!;
const relatedPosts = (await getCollection('insights')).filter(item=>item.id!==post.id).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
const schema = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString().slice(0,10), inLanguage: 'ko-KR', author: { ...personSchema, ...(Astro.site ? { url: new URL('/#about', Astro.site).href } : {}) }, ...(Astro.site ? { mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href } : {}) };
---
<Layout title={`${post.data.title} | ${authorName}의 전문 칼럼`} description={post.data.description} article schema={schema}>
  <article class="article-wrap">
    <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><Icon name="chevron" size={12} /><a href="/insights/">전문 칼럼</a><Icon name="chevron" size={12} /><span aria-current="page">{post.data.category}</span></nav>
    <header class="article-header"><span class="eyebrow">ONYUL JOURNAL / {post.data.category}</span><h1>{post.data.title}</h1><div class="article-meta"><a href="/#about">글쓴이 {authorName}</a><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0,10).replaceAll('-','.')}</time><span>{post.data.readTime}분 읽기 · 샘플 칼럼</span></div><p class="article-intro">{post.data.description}</p></header>
    {post.data.keyPoints.length > 0 && <section class="article-key-points" aria-labelledby="key-points-title"><h2 id="key-points-title">이 글에서 함께 살펴볼 것</h2><ul>{post.data.keyPoints.map(point=><li>{point}</li>)}</ul></section>}
    <div class="prose"><Content /></div>
    <aside class="practice-banner">미래의 전문가 모습을 가정한 개인 브랜딩 연습용 칼럼입니다. 의료정보는 진단·치료를 대신하지 않습니다. 실제 의료광고에 활용하기 전 법규와 심의 대상 여부를 검토해 주세요.</aside>
    <aside class="author-card" aria-labelledby="author-title"><ProfilePortrait compact /><div><span class="eyebrow">ABOUT THE AUTHOR</span><h2 id="author-title">이 글을 쓴 {authorName}입니다.</h2><p>{site.profile.introduction}</p><a class="text-link" href="/#about">전문가 소개 살펴보기 <Icon name="arrow" size={19} /></a></div></aside>
    <section class="article-related-service" aria-labelledby="related-service-title"><span class="eyebrow">FROM IDEAS TO CONTENT</span><h2 id="related-service-title">이 관점이 필요한 일이 있다면</h2><p><strong>{relatedService.title}</strong><br />{relatedService.text}</p><div class="related-service-actions"><a class="text-link related-expertise-link" href={`/#service-${relatedService.id}`}>관련 전문 분야 살펴보기 <Icon name="arrow" size={19} /></a><a class="button button-primary article-inquiry" href={`/contact/?service=${relatedService.id}&article=${encodeURIComponent(post.id)}`}>이 주제로 협업 문의 <Icon name="diagonal" size={19} /></a></div></section>
    <div class="article-end"><a class="text-link" href="/insights/"><Icon name="arrow" class="back-arrow" size={18} /> 전문 칼럼 목록</a><button class="button button-outline" id="share-article" type="button"><Icon name="copy" size={17} /> 글 링크 복사</button></div><p class="share-status" role="status"></p>
    <section class="related-reading" aria-labelledby="related-reading-title"><h2 id="related-reading-title">생각을 이어갈 다음 글</h2><div class="related-reading-grid">{relatedPosts.map(item=><ArticleCard post={item} />)}</div></section>
  </article>
  <ContactCTA />
</Layout>
<script>
  document.querySelector('#share-article')?.addEventListener('click', async () => {
    const status = document.querySelector('.share-status');
    try { await navigator.clipboard.writeText(window.location.href); if (status) status.textContent = '글 링크를 복사했습니다.'; }
    catch { if (status) status.textContent = '주소창의 링크를 직접 복사해 주세요.'; }
  });
</script>
