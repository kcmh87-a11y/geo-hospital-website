---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getCollection } from 'astro:content';
import { authorName } from '../../config/site';
const posts = (await getCollection('insights')).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf());
const categories = ['전체', 'GEO · AIO', '콘텐츠 전략', '병원 마케팅'];
---
<Layout title={`전문 칼럼 — GEO/AIO와 병원 콘텐츠 | ${authorName}`} description="GEO/AIO 병원 마케팅을 탐구하고 쓰는 개인 전문가의 기록. AI 검색, 환자의 질문, 콘텐츠 기획과 협업을 다룬 칼럼을 읽어보세요.">
  <section class="page-heading"><div class="container"><nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><Icon name="chevron" size={12} /><span aria-current="page">전문 칼럼</span></nav><span class="eyebrow">A PERSONAL JOURNAL ON GEO & CONTENT</span><h1>변화를 읽는 시선,<br />콘텐츠를 만드는 생각.</h1><p>병원 GEO/AIO와 콘텐츠를 주제로 제가 탐구하고 쓰는 글입니다.<br />한 편의 칼럼에서 시작해, 생각이 맞닿는 지점을 찾아보세요.</p><a class="text-link journal-intro-link" href="/#about">글쓴이 {authorName} 소개 <Icon name="arrow" size={19} /></a></div></section>
  <section class="section"><div class="container"><div class="filter-bar" role="group" aria-label="칼럼 분야 선택">{categories.map((category,index)=><button type="button" class="filter-button" data-filter={category} aria-pressed={index===0}>{category}</button>)}<span class="filter-count" aria-live="polite">총 <span id="post-count">{posts.length}</span>편의 인사이트</span></div><div class="insight-list">{posts.map(post=><div data-category={post.data.category}><ArticleCard post={post} featured={post.data.featured} /></div>)}</div></div></section>
  <ContactCTA />
</Layout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  buttons.forEach(button => button.addEventListener('click', () => {
    const category = button.dataset.filter;
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    let count = 0;
    cards.forEach(card => { card.hidden = category !== '전체' && card.dataset.category !== category; if (!card.hidden) count++; });
    const counter = document.querySelector('#post-count'); if (counter) counter.textContent = String(count);
  }));
</script>
