{
  "name": "onyul-healthcare-geo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "test": "playwright test",
    "preview:export": "node scripts/export-preview.mjs",
    "preview:capture": "node scripts/capture-preview.mjs",
    "preview:refresh": "npm run build && npm run preview:export && npm run preview:capture"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@fontsource/cormorant-garamond": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  }
}
